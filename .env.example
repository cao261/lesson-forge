# ============ 模型主备（必填） ============
# 主模型：额度充足时一直用它
PRIMARY_NAME=主模型
PRIMARY_API_KEY=在这里粘贴你的_MiniMax_Key
PRIMARY_BASE_URL=https://api.minimaxi.com/v1
PRIMARY_MODEL=MiniMax-M3
# 请求体格式：openai 或 anthropic
PRIMARY_PROTOCOL=openai
# 是否支持看图（1=支持）。主模型关掉的话，题目转写会直接降到备用模型
PRIMARY_VISION=1

# 备用模型：主模型额度用完时自动接管。免费/限速的额度一般放这里
FALLBACK_ENABLED=1
FALLBACK_NAME=备用模型
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://apihub.agnes-ai.com/v1
FALLBACK_MODEL=agnes-3.0-flash
FALLBACK_PROTOCOL=openai
# 每分钟最多几次请求，程序会自动排队，不会超速
FALLBACK_RPM=10
FALLBACK_VISION=1
# 主模型连续过载、重试用尽后，是否也降级到备用模型
FALLBACK_ON_OVERLOAD=1

# 深度思考模式：adaptive（自动，推荐）/ enabled（总是思考，质量最高）/ disabled（关闭，最快）
MINIMAX_THINKING=adaptive
MINIMAX_TEMPERATURE=0.2
MINIMAX_MAX_TOKENS=32000
MINIMAX_TIMEOUT=600
MINIMAX_MAX_RETRIES=4
# 单次调用（含所有重试）的总时限，防止服务端过载时卡死
MINIMAX_CALL_DEADLINE=1500

# ============ 本地语音转写（Whisper） ============
# 模型：tiny / base / small / medium / large-v3 / distil-large-v3
WHISPER_MODEL=large-v3
# auto / cuda / cpu
WHISPER_DEVICE=auto
# float16 / int8_float16 / float32
WHISPER_COMPUTE=float16
# 语言，zh 中文 / en 英文 / auto 自动识别
WHISPER_LANGUAGE=zh
# 国内建议走镜像，下载模型快很多
HF_ENDPOINT=https://hf-mirror.com

# ============ 抓取 ============
# B 站会拦未登录请求（HTTP 412）。填浏览器名借用登录态：
#   chrome / edge / firefox，也可以写 edge:Default、edge:Profile 1
# 注意：浏览器必须【完全退出】，否则 Cookie 库被锁住会读不出来。
# 实在不行就改用 BILI_COOKIES_FILE 指向一个 cookies.txt。
BILI_COOKIES_FROM_BROWSER=
BILI_COOKIES_FILE=
FFMPEG_BIN=
# 下载画质上限：best / 1080 / 720 / 480
VIDEO_QUALITY=best

# ============ 生成策略 ============
# 例题截图候选帧数量（越多越准越慢）
SHOT_CANDIDATES=4
# 例题搜索窗口：题目出现时间戳前 / 后（秒）
SHOT_PRE_ROLL=3
SHOT_POST_ROLL=45
# 审核-回炉最大轮数
MAX_REVIEW_ROUNDS=2
# 审核时是否把例题原图也喂给模型看（更准，token 消耗大）
VISION_REVIEW=0

# ============ 其它 ============
WORKSPACE_DIR=workspace
HOST=127.0.0.1
PORT=8760
# 1 = 不调用大模型，用本地假数据跑通流程（调试用）
LESSONFORGE_MOCK=0
# MML2OMML.XSL 路径（Word 真公式转换）。留空自动探测本机 Office
MML2OMML_XSL=