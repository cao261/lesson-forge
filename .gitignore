# ---- 依赖与构建产物 ----
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ---- 密钥：绝对不能提交 ----
.env
.env.*
!.env.example
# B 站登录态。curl 从浏览器抓下来的 cookie 等于账号凭据，
# 进了 git 历史就等于泄露，删文件也删不掉，只能改密码。
*cookies*.txt

# ---- 素材与产物（体积大，且是老师的私有内容）----
workspace/
selfcheck_out/
*.wav
*.mp4
*.webm
*.mkv
*.flv
*.part
*.docx
*.html
!app/web/static/*.html

# ---- 本地临时探针（下划线开头是排查问题时的一次性脚本）----
/_*.py
/_bili_*.json

# ---- 工具链落下的临时文件 ----
/_gh_login_*.txt
*.unknown_video

